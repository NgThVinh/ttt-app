NEXT_PUBLIC_APP_NAME=3T
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel production: NEXT_PUBLIC_APP_URL=https://thichtinhtien.online
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# CLI migrations only. PostgreSQL owner connection; never prefix with NEXT_PUBLIC_.
SUPABASE_DB_URL=
# Optional path to a trusted CA PEM; defaults to the bundled public Supabase root.
SUPABASE_DB_CA_CERT=
# Server check + private DB allowlist; run db:admins:sync after changing this list.
SUPER_ADMIN_EMAILS=
AI_KEY_ENCRYPTION_SECRET=
# Allowed HTTPS hosts for super-admin-configured OpenAI-compatible providers.
AI_ALLOWED_COMPATIBLE_HOSTS=api.openai.com
AI_KILL_SWITCH=0
CRON_SECRET=
# Internal server jobs only; never expose to clients or AI tools.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Operator-owned Quick Link template; leave blank to use copy-bank-details fallback.
NEXT_PUBLIC_VIETQR_TEMPLATE=
