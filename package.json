{
  "name": "3t",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:concurrency": "node scripts/test-concurrency.mjs",
    "db:status": "node --env-file=.env scripts/migrate.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs --apply",
    "db:verify": "node --env-file=.env scripts/verify-hosted.mjs",
    "db:cron": "node --env-file=.env scripts/install-cron.mjs",
    "db:cron:install": "node --env-file=.env scripts/install-cron.mjs --apply",
    "db:storage:install": "node --env-file=.env scripts/install-storage-cleanup.mjs",
    "db:storage:verify": "node --env-file=.env scripts/verify-storage.mjs",
    "db:admins": "node --env-file=.env scripts/sync-super-admins.mjs",
    "db:admins:sync": "node --env-file=.env scripts/sync-super-admins.mjs --apply",
    "db:verify:group-retry": "node --env-file=.env scripts/verify-group-retry.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
